# ===== 忽略所有，只放行工具文件 =====
/*
!/.gitignore
!/LICENSE
!/README.md
!/requirements.txt
!/book.css
!/epub_to_html.py
!/run.py
!/WeasyPrint方案使用说明.md

# ===== 放行文件 =====
!/CHANGELOG.md

# ===== 中间产物（双重保险） =====
*.pdf
*.epub
*.html
assets/
output/
temp/

# ===== Python =====
__pycache__/
*.py[cod]
venv/
.venv/

# ===== 编辑器 =====
.vscode/
.idea/
*.swp

# ===== 操作系统 =====
.DS_Store
Thumbs.db

# ===== 放行示例文件 =====
!/examples/
!/examples/README.md
!/examples/sample-input.epub
!/examples/sample-output.pdf